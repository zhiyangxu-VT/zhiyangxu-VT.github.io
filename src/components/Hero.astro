---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
---

<section class="hero shell" id="about" aria-labelledby="hero-title">
  <div class="hero__portrait-wrap">
    <Image
      class="hero__portrait"
      src={portrait}
      alt="Portrait of Zhiyang Xu"
      widths={[480, 720, 960]}
      sizes="(max-width: 720px) 100vw, 42vw"
      loading="eager"
      fetchpriority="high"
      quality={88}
    />
  </div>

  <div class="hero__content">
    <h1 id="hero-title">Zhiyang Xu</h1>
    <p class="hero__statement">
      I am a Senior Research Scientist at the MBZUAI Institute of Foundation Models (IFM)
      in Silicon Valley, working on video world model pretraining. I earned my Ph.D. from
      Virginia Tech, advised by Prof. Lifu Huang, with a dissertation titled
      <em>Towards Unified and Generalizable Multimodal Foundation Models</em>, after completing
      my B.S. at Rensselaer Polytechnic Institute. Previously, I interned at Meta GenAI and Apple AI/ML.
    </p>
    <div class="hero__links" aria-label="Contact and profiles">
      <a href="mailto:zhiyangx@vt.edu">Email</a>
      <a
        href="https://www.linkedin.com/in/zhiyang-xu-95462a335/"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn (opens in a new tab)"
      >LinkedIn <span aria-hidden="true">↗</span></a>
      <a
        href="https://scholar.google.com/citations?user=11zbVUAAAAAJ&hl=en&oi=sra"
        target="_blank"
        rel="noreferrer"
        aria-label="Google Scholar (opens in a new tab)"
      >Google Scholar <span aria-hidden="true">↗</span></a>
      <a
        href="https://github.com/zhiyangxu-VT"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub (opens in a new tab)"
      >GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
