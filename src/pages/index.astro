---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const title = 'Zhiyang Xu — Senior Research Scientist';
const description =
  'Zhiyang Xu is a Senior Research Scientist at the MBZUAI Institute of Foundation Models working on video world model pretraining.';
---

<BaseLayout {title} {description}>
  <div id="top"></div>
  <Header />
  <main>
    <Hero />

    <nav class="profile-links shell" aria-label="Contact and profiles">
      <a href="mailto:zhiyangx@vt.edu">Email</a>
      <a
        href="https://www.linkedin.com/in/zhiyang-xu-95462a335/"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn (opens in a new tab)"
      >LinkedIn <span aria-hidden="true">↗</span></a>
      <a
        href="https://scholar.google.com/citations?user=11zbVUAAAAAJ&hl=en&oi=sra"
        target="_blank"
        rel="noreferrer"
        aria-label="Google Scholar (opens in a new tab)"
      >Google Scholar <span aria-hidden="true">↗</span></a>
      <a
        href="https://github.com/zhiyangxu-VT"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub (opens in a new tab)"
      >GitHub <span aria-hidden="true">↗</span></a>
    </nav>

    <section class="projects shell" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="eyebrow">Selected research</p>
        <h2 id="projects-title">Projects</h2>
        <p>Selected work in multimodal pretraining, understanding, and generation.</p>
      </div>

      <div class="projects__list">
        {projects.map((project, index) => <ProjectCard {project} {index} />)}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
